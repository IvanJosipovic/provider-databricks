{
  "name": "provider-databricks",
  "image": "mcr.microsoft.com/devcontainers/go:1.24",
  "features": {
    // "ghcr.io/devcontainers/features/docker-in-docker:2": {
    //   "version": "latest"
    // }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "go.toolsManagement.autoUpdate": true,
        "editor.formatOnSave": true
      },
      "extensions": [
        "golang.Go",
        "github.copilot",
        "ms-kubernetes-tools.vscode-kubernetes-tools",
        "ms-vscode.makefile-tools"
      ]
    }
  },
  "postCreateCommand": "command -v git-lfs >/dev/null 2>&1 || (sudo apt-get update && sudo apt-get install -y git-lfs) && git lfs install && git submodule update --init --recursive && go mod download",
  "postStartCommand": "make help",
  "remoteUser": "vscode"
}